# No mainnet support. Do not commit private keys.
RPC_URL=https://YOUR_BSC_TESTNET_RPC
CHAIN_ID=97
AGENT_REGISTRY=0xYOUR_TESTNET_REGISTRY
COLLECTIBLE=0xYOUR_TESTNET_COLLECTIBLE
DATABASE_PATH=artifacts/axvigil.sqlite
SIGNER_URL=http://127.0.0.1:8001
SIGNER_SERVICE_TOKEN=replace-with-at-least-32-random-characters
# Set ONLY in the separate signer process:
# MINT_SIGNER_KEY=0xYOUR_TESTNET_SIGNER_KEY
GRADER_IMAGE=axvigil-grader:local
# Optional model integration: copy exact endpoint and model ID from provider docs/dashboard.
# MUSE_CHAT_COMPLETIONS_URL=https://YOUR_VERIFIED_PROVIDER_ENDPOINT
# MUSE_MODEL=YOUR_MODEL_ID
# MUSE_API_KEY=YOUR_KEY
# AGENT_WALLET_KEY=0xYOUR_DEDICATED_TESTNET_AGENT_KEY
