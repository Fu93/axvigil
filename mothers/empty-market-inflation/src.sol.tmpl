pragma solidity 0.8.28;

interface IERC20Like {
    function transfer(address to, uint256 amount) external returns (bool);
    function transferFrom(address from, address to, uint256 amount) external returns (bool);
    function balanceOf(address who) external view returns (uint256);
}

/// @notice AxVigil challenge target (sandbox, BSC testnet only). Deliberately
///         vulnerable for an AI agent to find and fix. Do not deploy to mainnet.
///
/// A minimal share vault over one ERC20 asset. Depositors receive shares; shares
/// redeem for a pro-rata slice of the pool. Based on the empty-market share
/// inflation that hit Compound forks (Hundred Finance, Sonne) in 2023.
contract Czz {
    IERC20Like public immutable vzzAsset;
    uint256 public vzzTotalShares;
    uint256 public vzzBook; // assets actually deposited through the vault
    mapping(address => uint256) public vzzShares;

    event Deposited(address indexed who, uint256 assets, uint256 shares);
    event Redeemed(address indexed who, uint256 shares, uint256 assets);

    constructor(address asset_) {
        vzzAsset = IERC20Like(asset_);
    }

// @@SHUF_BEGIN@@
// @@SHUF@@
    /// @notice Deposit `assets` and receive shares pro-rata to the current pool.
    function fzzDeposit(uint256 assets) external returns (uint256 shares) {
        require(assets > 0, "zero assets");
        uint256 pool = fzzPoolValue();
        shares = vzzTotalShares == 0 ? assets : (assets * vzzTotalShares) / pool;
        vzzAsset.transferFrom(msg.sender, address(this), assets);
        vzzTotalShares += shares;
        vzzShares[msg.sender] += shares;
        vzzBook += assets;
        emit Deposited(msg.sender, assets, shares);
    }
// @@SHUF@@
    /// @notice Burn `shares` and receive a pro-rata slice of the pool.
    function fzzRedeem(uint256 shares) external returns (uint256 assets) {
        require(vzzShares[msg.sender] >= shares, "exceeds shares");
        uint256 pool = fzzPoolValue();
        assets = (shares * pool) / vzzTotalShares;
        vzzTotalShares -= shares;
        vzzShares[msg.sender] -= shares;
        vzzBook -= assets > vzzBook ? vzzBook : assets;
        vzzAsset.transfer(msg.sender, assets);
        emit Redeemed(msg.sender, shares, assets);
    }
// @@SHUF@@
    /// @notice The pool's live asset balance (moves when anyone transfers in).
    function fzzPoolValue() public view returns (uint256) {
        return vzzAsset.balanceOf(address(this));
    }
// @@SHUF@@
    /// @notice Assets actually deposited through the vault (ignores donations).
    function fzzBookValue() public view returns (uint256) {
        return vzzBook;
    }
// @@SHUF@@
    function fzzTotal() external view returns (uint256) {
        return vzzTotalShares;
    }
// @@SHUF_END@@
}
