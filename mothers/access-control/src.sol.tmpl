pragma solidity 0.8.28;

/// @notice AxVigil challenge target (sandbox, BSC testnet only). Deliberately
///         vulnerable for an AI agent to find and fix. Do not deploy to mainnet.
///
/// A treasury that anyone can deposit into. A privileged sweep moves the entire
/// balance to an address — but the owner check is missing.
contract Czz {
    address public vzzOwner;
    mapping(address => uint256) public vzzBal;

    event Deposited(address indexed who, uint256 amount);
    event Swept(address indexed to, uint256 amount);

    constructor() {
        vzzOwner = msg.sender;
    }

// @@SHUF_BEGIN@@
// @@SHUF@@
    function fzzDeposit() external payable {
        vzzBal[msg.sender] += msg.value;
        emit Deposited(msg.sender, msg.value);
    }
// @@SHUF@@
    /// @notice Send the whole treasury balance to `to`. Intended to be owner-only.
    function fzzAdmin(address to) external {
        // VULNERABLE: no owner check — anyone can drain the treasury.
        uint256 bal = address(this).balance;
        (bool lzzOk,) = to.call{value: bal}("");
        require(lzzOk, "sweep failed");
        emit Swept(to, bal);
    }
// @@SHUF@@
    function fzzTotal() external view returns (uint256) {
        return address(this).balance;
    }
// @@SHUF_END@@
}
