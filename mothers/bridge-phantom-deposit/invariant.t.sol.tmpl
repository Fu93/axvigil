pragma solidity 0.8.28;

import {Test} from "forge-std/Test.sol";
import {Czz} from "../src/Czz.sol";

contract Handler {
    Czz public bridge;
    bool public broken;

    constructor(Czz b) {
        bridge = b;
    }

    function phantom(uint256 amount) external {
        amount = (amount % 1_000_000 ether) + 1;
        uint256 native = bridge.fzzTotalNative();
        if (native == 0) return;
        if (amount > native) amount = native;
        bytes32 rid = bridge.NATIVE_RESOURCE();
        uint256 beforeNative = native;
        // The native resource is listed as address(0). A successful ERC20 deposit
        // here moved no tokens; that is the phantom credit.
        try bridge.fzzDeposit(rid, amount) {
            broken = true;
        } catch {}
        try bridge.fzzWithdraw(rid, amount) {} catch {}
        if (bridge.fzzTotalNative() < beforeNative) broken = true;
    }
}

contract InvariantTest is Test {
    Czz internal bridge;
    Handler internal handler;
    address internal owner = makeAddr("owner");
    address internal victim = makeAddr("victim");
    uint256 internal constant FUNDED = 4 ether;

    function setUp() public {
        vm.prank(owner);
        bridge = new Czz();
        vm.deal(victim, FUNDED);
        vm.prank(victim);
        bridge.fzzDepositNative{value: FUNDED}();
        handler = new Handler(bridge);
        handler.phantom(FUNDED);

        excludeContract(address(this));
        excludeContract(address(bridge));
        targetContract(address(handler));
        bytes4[] memory sels = new bytes4[](1);
        sels[0] = bytes4(keccak256("phantom(uint256)"));
        targetSelector(FuzzSelector({addr: address(handler), selectors: sels}));
    }

    function invariant_honestNativeStays() public view {
        assertFalse(handler.broken());
        assertGe(bridge.fzzTotalNative(), FUNDED, "honest native deposit was drained");
    }

    function testFuzz_codelessTokenCannotDeposit(uint160 salt, uint96 amt) public {
        amt = uint96(bound(amt, 1, 1 ether));
        address ghost = address(uint160(bound(uint256(salt), 1, type(uint160).max)));
        vm.assume(ghost.code.length == 0);
        bytes32 rid = keccak256(abi.encodePacked(ghost));
        vm.prank(owner);
        bridge.fzzSetResource(rid, ghost);
        vm.prank(address(handler));
        vm.expectRevert();
        bridge.fzzDeposit(rid, amt);
        assertEq(bridge.vzzLocked(rid, address(handler)), 0);
    }
}
