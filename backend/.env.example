# Backend signer — the address here must be set as `signer` on the deployed
# AxVigilCollectible (constructor arg or setSigner). Keep this key OFF the
# contract owner/seed holder.
SIGNER_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
VERIFYING_CONTRACT=0x0000000000000000000000000000000000000000
CHAIN_ID=97

# Tooling the grader shells out to (defaults: whatever is on PATH).
# FORGE=/root/bin/forge
# SOLC=/path/to/solc-0.8.28

# Paths (default to the repo's own dirs).
# CHALLENGES_DIR=../challenges
# VERIFIER_DIR=../verifier

# Agent ID ownership. Login, reward start, and authorize call ownerOf(agentId)
# on this registry via RPC and require it to equal the signed-in wallet.
# AGENT_REGISTRY=0x7Aa441477f0246353bdAe504cF0F9B3027D6d45e
# RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
# Local dev only. Never set this in production: it lets any wallet claim any Agent ID.
# AXVIGIL_DEV_SKIP_OWNERSHIP=1

GRADE_TIMEOUT_S=120
AUTH_TTL_S=3600
