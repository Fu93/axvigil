# Copy to backend/.env and fill in after you deploy. Do not commit the copy.
#
# SIGNER_KEY is the backend's EIP-712 key. It must not be the contract owner
# and must not be the commit-reveal seed holder. The owner points the live
# contract at this key's address with scripts/rotate_signer.sh (setSigner).
# That rotation has not been sent on BSC testnet yet: the deployer address
# is still the signer until the operator runs it. Leave this empty until then.
# scripts/judge_demo.sh sets a public Anvil account for the local demo.
# Never use that key on a network where it can move real funds.
SIGNER_KEY=

# Collectible the signer is registered on. rotate_signer.sh reads the same name.
# AXVIGIL_COLLECTIBLE=0x06580BFc1626f7DD3d7B841FD304e6f2B23e4658

# Collectible address from the deploy. Empty or the zero address does not enable signing.
VERIFYING_CONTRACT=

CHAIN_ID=97

# openssl rand -hex 32
SESSION_SECRET=change-me

# Who owns an Agent ID. Login, reward start, and authorize call ownerOf.
# Defaults used by docker compose when these are unset in the shell:
#   RPC_URL=https://bsc-testnet.bnbchain.org
#   AGENT_REGISTRY=0x7Aa441477f0246353bdAe504cF0F9B3027D6d45e
# Point both at a local anvil MockAgentID for the judge demo.
# RPC_URL=https://bsc-testnet.bnbchain.org
# AGENT_REGISTRY=0x7Aa441477f0246353bdAe504cF0F9B3027D6d45e
# Local dev only. Never set this where the API is reachable by anyone else.
# AXVIGIL_DEV_SKIP_OWNERSHIP=1

# Forge downloads solc. Set SOLC only to pin a binary.
# FORGE=/usr/local/bin/forge
# SOLC=/path/to/solc-0.8.28

# GRADE_TIMEOUT_S=120
# AUTH_TTL_S=3600
# SESSION_TTL_S=1800

# Live deals run the reference solution through the grader before the source
# is shown, and skip a seed whose structural fingerprint was already issued.
# Set to 0 only for a local demo that must open sessions without forge.
# AXVIGIL_REFERENCE_CHECK=1

# Evidence bundles (canonical JSON + patch/PoC/source). CID is computed locally.
# EVIDENCE_DIR=backend/evidence
# Optional pin. Grading still returns the local CID if the pin request fails.
# IPFS_PIN_URL=
# IPFS_PIN_TOKEN=
