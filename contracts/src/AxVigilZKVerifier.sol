pragma solidity ^0.8.24;

import {IAgentRegistry} from "./interfaces/IAgentRegistry.sol";
import {IAxVigilSkill} from "./interfaces/IAxVigilSkill.sol";

/// @notice SP1 / RISC Zero standard zkVM on-chain verifier interface.
interface ISP1Verifier {
    function verifyProof(
        bytes32 programVKey,
        bytes calldata publicValues,
        bytes calldata proofBytes
    ) external view;
}

/// @title AxVigilZKVerifier
/// @notice Zero-Knowledge capability attestation verifier.
/// Enables AI agents to trustlessly prove they remediated a 0-day smart-contract
/// vulnerability without disclosing the patch source code or exploit payload before deployment.
contract AxVigilZKVerifier {
    ISP1Verifier public immutable zkVerifier;
    bytes32 public immutable crucibleProgramVKey;
    IAgentRegistry public immutable agentRegistry;
    IAxVigilSkill public immutable skill;

    /// @notice Nullifiers preventing replay attacks: keccak256(challengeId, patchCommitment) => bool
    mapping(bytes32 => bool) public nullifiers;

    event ZKSolveVerified(
        uint256 indexed agentId,
        bytes32 indexed challengeId,
        bytes32 patchCommitment,
        uint8 checksBitmap
    );

    struct ZKPublicValues {
        uint256 agentId;
        bytes32 challengeId;
        bytes32 patchCommitment;
        bytes32 originalCodeHash;
        uint8 checksBitmap; // Bit 0: pocProvesBug, Bit 1: pocFailsAfterPatch, Bit 2: hiddenTestsPass, Bit 3: patchWithinLimits, Bit 4: invariantsHold
        uint64 timestamp;
        bool passed;
    }

    error InvalidZKProof();
    error IncompleteChecks(uint8 actualBitmap);
    error AlreadySubmitted();
    error NotAgentOwner();
    error SolveFailed();

    constructor(
        address _zkVerifier,
        bytes32 _crucibleProgramVKey,
        address _agentRegistry,
        address _skill
    ) {
        require(_zkVerifier != address(0), "ZERO_VERIFIER");
        require(_agentRegistry != address(0), "ZERO_REGISTRY");
        require(_skill != address(0), "ZERO_SKILL");
        zkVerifier = ISP1Verifier(_zkVerifier);
        crucibleProgramVKey = _crucibleProgramVKey;
        agentRegistry = IAgentRegistry(_agentRegistry);
        skill = IAxVigilSkill(_skill);
    }

    /// @notice Trustlessly verifies a zero-knowledge capability proof without revealing the patch or PoC.
    /// @param publicValuesRaw ABI-encoded ZKPublicValues from the zkVM execution journal.
    /// @param proofBytes zk-SNARK / zk-STARK proof bytes generated by the zkVM prover.
    /// @param vulnClass The vulnerability family (1-9).
    /// @param difficulty Challenge difficulty level (0-2).
    function verifyAndRecord(
        bytes calldata publicValuesRaw,
        bytes calldata proofBytes,
        uint8 vulnClass,
        uint8 difficulty
    ) external {
        // 1. Cryptographically verify the zk-SNARK proof against the certified crucible program verification key
        zkVerifier.verifyProof(crucibleProgramVKey, publicValuesRaw, proofBytes);

        // 2. Decode the committed public values journal
        ZKPublicValues memory pv = abi.decode(publicValuesRaw, (ZKPublicValues));

        // 3. Ensure the zkVM run marked the challenge as passed
        if (!pv.passed) revert SolveFailed();

        // 4. Ensure all 5 differential security checks satisfied (bits 0..4 = 0x1F = 31)
        if (pv.checksBitmap != 31) revert IncompleteChecks(pv.checksBitmap);

        // 5. Ensure caller is the legitimate owner of the SPACE ID Agent ID
        if (agentRegistry.ownerOf(pv.agentId) != msg.sender) revert NotAgentOwner();

        // 6. Anti-replay protection: prevent reusing the same proof / patch commitment
        bytes32 nullifier = keccak256(abi.encodePacked(pv.challengeId, pv.patchCommitment));
        if (nullifiers[nullifier]) revert AlreadySubmitted();
        nullifiers[nullifier] = true;

        // 7. Trustlessly record and confirm the skill solve on the ERC-5192 Soulbound Token
        skill.recordSolve(pv.agentId, vulnClass, difficulty);
        skill.confirmSolve(pv.agentId, vulnClass);

        emit ZKSolveVerified(pv.agentId, pv.challengeId, pv.patchCommitment, pv.checksBitmap);
    }
}
